<table class="statistics-table">
    <thead>
        <tr>
            <th data-sort="name">Name <span class="sort-icon">↕</span></th>
            <th data-sort="copilotAcceptedUsage">Tabs Accepted <span class="sort-icon">↕</span></th>
            <th data-sort="numRequests">Premium Requests Used <span class="sort-icon">↕</span></th>
            <th data-sort="copilotUsage">Copilot Usage <span class="sort-icon">↕</span></th>
            <th data-sort="email">Email <span class="sort-icon">↕</span></th>
            <th data-sort="role">Role <span class="sort-icon">↕</span></th>
            <th data-sort="maxRequestUsage">Max Request Usage <span class="sort-icon">↕</span></th>
        </tr>
    </thead>
    <tbody>
        <% statistics.forEach(function(member) { %>
            <tr>
                <td><%= member.name %></td>
                <td style="text-align: right;"><%= member.copilotAcceptedUsage %></td>
                <td style="text-align: right;"><%= member.numRequests %></td>
                <td style="text-align: right;"><%= member.copilotUsage %></td>
                <td><%= member.email %></td>
                <td><%= member.role %></td>
                <td style="text-align: right;"><%= member.maxRequestUsage %></td>
            </tr>
        <% }); %>
    </tbody>
</table> 